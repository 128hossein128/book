# Supabase > Project Settings > API Keys / Connect
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# رمز ورود مدیر (در Vercel به عنوان Secret نگهداری شود)
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# حداقل 32 کاراکتر تصادفی برای امضای نشست مدیر
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
